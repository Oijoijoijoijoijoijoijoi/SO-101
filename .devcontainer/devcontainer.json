{
    "name": "SO-101 ESP32 Jazzy Hub",
    "build": { "dockerfile": "Dockerfile" },
    "runArgs": [ "--privileged", "--network=host" ],
    "mounts": [
        "source=/dev,target=/dev,type=bind",
        "source=esp32-bash-history,target=/home/vscode/command_history,type=volume"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "idf.espIdfPath": "/opt/esp/idf",
                "idf.toolsPath": "/home/vscode/.espressif",
                "idf.pythonBinPath": "/home/vscode/.espressif/python_env/idf5.3_py3.10_env/bin/python",
                "terminal.integrated.env.linux": {
                    "PYTHONPATH": "/opt/ros/jazzy/lib/python3.11/site-packages"
                },
                "C_Cpp.default.includePath": [
                    "${workspaceFolder}/**",
                    "/opt/esp/idf/components/**",
                    // Path to generated headers in the project build folder
                    "${workspaceFolder}/**/build/muros_include/**"
                ]
            },
            "extensions": [
                "espressif.esp-idf-extension",
                "ms-vscode.cpptools",
                "ms-iot.vscode-ros",
                "ms-vscode.cmake-tools",
                "usernamehw.errorlens",
                "eamodio.gitlens",
                "ms-python.python",
                "xaver.clang-format"
            ]
        }
    },
    "remoteUser": "vscode",
    "postCreateCommand": "bash .devcontainer/init_workspace.sh"
}