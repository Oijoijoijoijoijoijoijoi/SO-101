{
    "name": "SO-101 Robotics Dev",
    "build": { "dockerfile": "Dockerfile" },
    "runArgs": [
        "--privileged",
        "-v", "/dev:/dev",
        "--net=host"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "platformio.platformio-ide",
                "ms-vscode.cpptools"
            ]
        }
    },
    "remoteUser": "vscode"
}